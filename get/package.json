{
  "name": "timpi-drip",
  "version": "1.0.0",
  "description": "Timpi Drip - Community faucet for NTMPI tokens",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/",
    "build:get": "cd get && node build.cjs",
    "build:all": "npm run build:get && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "test": "vitest"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/cookie": "^9.3.1",
    "better-sqlite3": "^9.4.3",
    "clawpurse": "github:mhue-ai/ClawPurse",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/better-sqlite3": "^7.6.8",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0"
  },
  "author": "Mhue.ai",
  "license": "ISC"
}
