# Timpi Drip Configuration

# Server
PORT=3000
ADMIN_PORT=3001
HOST=0.0.0.0

# Wallet (REQUIRED)
FAUCET_WALLET_PASSWORD=your-secure-password-here
KEYSTORE_PATH=~/.clawpurse/keystore.enc

# Drip amounts (in NTMPI)
DRIP_AMOUNT_NEW=0.5
DRIP_AMOUNT_TRUSTED=1.0

# Cooldowns (in hours)
COOLDOWN_NEW=48
COOLDOWN_TRUSTED=24

# Trust criteria
TRUST_WALLET_AGE_DAYS=7
TRUST_MIN_TXS=3

# Rate limiting
MAX_DRIPS_PER_IP=5
MAX_DRIPS_PER_HOUR=100

# Proof of Work
POW_DIFFICULTY=4

# Admin (REQUIRED)
ADMIN_PASSWORD=your-admin-password-here
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# Alerts
ALERT_LOW_BALANCE=2500
ALERT_CRITICAL_BALANCE=1000
DISCORD_WEBHOOK=
ALERT_EMAIL=

# Database
DB_PATH=./data/faucet.db

# Explorer
EXPLORER_URL=https://explorer.neutaro.io

# OpenClaw
OPENCLAW_ENABLED=true
OPENCLAW_PUBLIC_KEYS=
